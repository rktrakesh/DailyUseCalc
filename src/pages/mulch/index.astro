---
import { ArrowRight, ChevronRight, CircleHelp } from 'lucide-react';
import AdSlot from '../../components/common/AdSlot.astro';
import MulchCalculator from '../../features/calculators/mulch/MulchCalculator';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculatorCategories } from '../../data/calculators';
import {
  breadcrumbSchema,
  faqPageSchema,
  organizationSchema,
  webApplicationSchema,
} from '../../lib/seo/schema';
const title = 'Mulch Calculator - Cubic Yards, Bags & Cost | DailyUseCalc';
const description =
  'Calculate mulch in cubic yards, cubic feet, cubic meters, liters, and bags. Estimate garden-bed coverage, bulk orders, leftover, and optional material cost.';
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Landscaping', path: '/calculators/#garden' },
  { name: 'Mulch Calculator', path: '/mulch/' },
];
const faqs = [
  {
    question: 'How much mulch do I need?',
    answer:
      'Measure the project area and choose the intended depth. The calculator multiplies area by depth, applies your selected allowance, and converts the result into bulk and bagged purchasing quantities.',
  },
  {
    question: 'How deep should mulch be?',
    answer:
      'Appropriate depth varies with the mulch material, plants, soil, drainage, existing mulch, and project purpose. Follow product, landscape, or local horticultural guidance for your site.',
  },
  {
    question: 'How many bags of mulch equal a cubic yard?',
    answer:
      'One cubic yard contains 27 cubic feet. That equals 27 one-cubic-foot bags, 18 bags at 1.5 cubic feet, or 14 two-cubic-foot bags when rounding up.',
  },
  {
    question: 'How do I calculate mulch for a circular bed?',
    answer:
      'Measure the diameter. The calculator uses pi times the radius squared for area, then multiplies that area by the entered depth.',
  },
  {
    question: 'Should I buy mulch in bags or bulk?',
    answer:
      'Compare the bagged and bulk material estimates along with supplier minimums, delivery charges, storage, access, and handling. The calculator presents material costs neutrally when both prices are entered.',
  },
  {
    question: 'How much extra mulch should I order?',
    answer:
      'Extra allowance can help with minor measurement variation and spreading loss, but the appropriate percentage depends on the site and purchasing method.',
  },
  {
    question: 'How do I mulch around trees safely?',
    answer:
      'Keep mulch from direct contact with trunks and stems, and avoid piling it into a mulch volcano. Follow appropriate horticultural guidance for the tree and site.',
  },
];
const guides = [
  [
    'Project, measurement, and shapes',
    'Project type supplies guidance only. Measure by Dimensions for rectangle, square, circle, triangle, trapezoid, or ring areas, or choose Known Area. Triangle and trapezoid height means perpendicular height.',
  ],
  [
    'Units, area, and depth',
    'Use feet and inches or meters and centimeters. Known Area accepts square feet, square yards, or square meters. Required volume equals normalized area x depth.',
  ],
  [
    'Mulch and allowance',
    'Mulch type is informational and never changes volume. Base volume is area x depth. Required volume equals base volume plus the selected extra allowance.',
  ],
  [
    'Bagged purchasing',
    'Choose a bag size to calculate bags = required volume / bag volume, rounded up. Purchased volume equals bags x bag size; leftover equals purchased minus required.',
  ],
  [
    'Bulk purchasing',
    'If you enter an order increment, the recommendation rounds upward to that increment. Without one, the exact required quantity is shown. Supplier minimums and increments vary.',
  ],
  [
    'Pricing and comparison',
    'Price per bag and bulk price are optional and never affect quantity. When both are present, material costs are compared without claiming universal savings; delivery, taxes, and fees are excluded.',
  ],
  [
    'Worked example',
    'A 20 ft x 10 ft bed at 3 in deep has 200 sq ft of area and 50 cu ft base volume. With 5% allowance it requires 52.5 cu ft, or 1.9444 cu yd. That is 27 two-cu-ft bags with 1.5 cu ft left, or 2.00 cu yd at a 0.25-cu-yd bulk increment with about 0.0556 cu yd left.',
  ],
  [
    'Why actual needs vary',
    'Grade, measurement accuracy, existing material, settling, installation, bag sizes, bulk minimums, and supplier practices can change the final purchase.',
  ],
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/mulch/"
  structuredData={[
    organizationSchema(),
    breadcrumbSchema(breadcrumbs),
    webApplicationSchema({ name: 'Mulch Calculator', description, path: '/mulch/' }),
    faqPageSchema(faqs),
  ]}
>
  <div class="site-container py-3 sm:py-4">
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-xs text-ink-soft">
      {
        breadcrumbs.map((item, index) => (
          <>
            <a class="rounded hover:text-brand" href={item.path}>
              {item.name}
            </a>
            {index < breadcrumbs.length - 1 && <ChevronRight size={13} aria-hidden="true" />}
          </>
        ))
      }
    </nav>
    <div class="mt-3 max-w-2xl">
      <h1 class="text-balance text-3xl font-extrabold tracking-[-.05em] text-ink sm:text-4xl">
        Mulch Calculator
      </h1><p class="mt-1.5 text-sm leading-5 text-ink-soft">
        Calculate how much mulch you need in cubic yards, cubic feet, cubic meters, liters, and bags
        for garden beds, trees, landscaping, play areas, and more.
      </p><a
        href="#user-guide"
        data-mulch-guide
        class="mt-2 inline-flex rounded text-sm font-semibold text-brand hover:underline"
        >User Guide</a
      >
    </div>
    <div
      class="mt-3 grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_13rem] xl:grid-cols-[minmax(0,1fr)_18rem]"
    >
      <div><MulchCalculator client:load /><AdSlot class="mt-5 min-h-24 lg:hidden" /></div><aside
        class="hidden space-y-3 lg:-mt-[5.75rem] lg:block"
        aria-label="Mulch calculator resources"
      >
        <AdSlot class="min-h-44 xl:min-h-60" /><section
          class="rounded-card border border-line bg-panel p-5 shadow-card"
        >
          <h2 class="text-base font-extrabold">Related calculators</h2><ul
            class="mt-4 space-y-3 text-sm font-semibold text-brand"
          >
            <li><a href="/gravel/">Gravel Calculator</a></li><li>
              <a href="/paint/">Paint Calculator</a>
            </li><li><a href="/topsoil/">Topsoil Calculator</a></li>
          </ul>
        </section>
        <section class="rounded-card border border-line bg-panel p-4 shadow-card">
          <h2 class="text-sm font-extrabold tracking-[-0.025em] text-ink">Browse by category</h2>
          <nav class="mt-2 grid" aria-label="Calculator categories">
            {
              calculatorCategories.map((category) => (
                <a
                  class="min-h-9 content-center text-xs font-semibold text-brand hover:text-brand-strong"
                  href={`/calculators/#${category.id}`}
                >
                  {category.name}
                </a>
              ))
            }
          </nav>
        </section>
      </aside>
    </div>
    <section
      id="user-guide"
      class="mt-16 scroll-mt-24 border-t border-line pt-12 sm:mt-20 sm:pt-16"
    >
      <div class="max-w-3xl">
        <p class="text-sm font-bold text-brand">Mulch planning guide</p><h2
          class="mt-1 text-3xl font-extrabold tracking-[-.045em]"
        >
          Mulch Calculator User Guide
        </h2>
      </div><div class="mt-8 grid gap-x-10 gap-y-7 text-sm leading-6 text-ink-soft md:grid-cols-2">
        {
          guides.map(([heading, content]) => (
            <section class="border-l-2 border-brand/25 pl-4">
              <>
                <h3 class="font-extrabold text-ink">{heading}</h3>
                <p class="mt-2">{content}</p>
              </>
            </section>
          ))
        }
      </div>
    </section>
    <section class="mt-16 border-t border-line pt-12 sm:mt-20 sm:pt-16">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-extrabold tracking-[-.045em]">Mulch calculator questions</h2>
      </div><div class="mt-7 grid gap-3 lg:grid-cols-2">
        {
          faqs.map((faq) => (
            <details class="rounded-card border border-line bg-panel p-5 shadow-card">
              <>
                <summary class="flex cursor-pointer items-start gap-3 text-sm font-extrabold marker:content-none">
                  <CircleHelp className="mt-0.5 shrink-0 text-brand" size={18} aria-hidden="true" />
                  {faq.question}
                </summary>
                <p class="ml-[1.9rem] mt-3 text-sm leading-6 text-ink-soft">{faq.answer}</p>
              </>
            </details>
          ))
        }
      </div>
    </section>
    <section class="mt-16 rounded-2xl border border-brand/25 bg-brand-soft p-6 sm:mt-20 sm:p-8">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
        <h2 class="text-2xl font-extrabold">Find the next calculator for your project.</h2><a
          href="/calculators/"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-control bg-brand px-5 text-sm font-bold text-white transition-colors hover:bg-brand-strong"
          >Browse calculators <ArrowRight size={17} aria-hidden="true" /></a
        >
      </div>
    </section>
  </div>
  <script>
    import { trackCalculatorEvent } from '../../lib/analytics/calculatorAnalytics';
    document.querySelector('[data-mulch-guide]')?.addEventListener('click', () =>
      trackCalculatorEvent('calculator_guide', {
        calculator_id: 'mulch',
        calculator_name: 'Mulch Calculator',
      }),
    );
  </script>
</BaseLayout>
