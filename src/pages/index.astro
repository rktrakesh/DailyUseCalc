---
import { ArrowRight, BadgeCheck, ClipboardCheck, Gem, Search, ShieldCheck } from 'lucide-react';
import AdSlot from '../components/common/AdSlot.astro';
import CategoryIcon from '../components/common/CategoryIcon.astro';
import CompactCalculatorItem from '../components/common/CompactCalculatorItem.astro';
import { calculatorCategories, calculatorListings } from '../data/calculators';
import BaseLayout from '../layouts/BaseLayout.astro';
import { organizationSchema, websiteSchema } from '../lib/seo/schema';

const popularIds = ['gravel', 'concrete', 'paint', 'mulch'];
const popularCalculators = popularIds.map((id) =>
  calculatorListings.find((calculator) => calculator.id === id)!,
);
const popularSearches = ['Gravel', 'Concrete', 'Paint', 'Mortgage', 'Tile'];
const trustPoints = [
  { title: 'Accurate calculations', detail: 'Transparent formulas', icon: ClipboardCheck },
  { title: 'Practical guidance', detail: 'Clear next steps', icon: Gem },
  { title: 'No signup required', detail: 'Free browser tools', icon: ShieldCheck },
  { title: 'Works everywhere', detail: 'Desktop to mobile', icon: BadgeCheck },
];
---

<BaseLayout
  title="DailyUseCalc — Smart Calculators for Everyday Projects"
  description="Fast, trustworthy calculators for everyday projects. Plan gravel, concrete, paint, tile, and more with clear recommendations."
  structuredData={[organizationSchema(), websiteSchema()]}
>
  <section>
    <div
      class="site-container grid items-center gap-6 py-8 md:grid-cols-[minmax(0,1fr)_18rem] md:py-10 lg:gap-12"
    >
      <div class="max-w-2xl">
        <h1
          class="max-w-xl text-balance text-3xl font-extrabold tracking-[-0.05em] text-ink sm:text-4xl"
        >
          Smart calculators for <span class="text-brand">everyday projects</span>
        </h1>
        <p class="mt-2 text-sm font-medium text-ink-soft">Calculate. Plan. Decide.</p>
        <form
          id="calculator-search"
          action="/calculators/"
          class="mt-4 flex max-w-xl rounded-control border border-line bg-panel p-1 shadow-card focus-within:border-brand"
          role="search"
        >
          <label class="sr-only" for="homepage-calculator-search">Search calculators</label>
          <input
            id="homepage-calculator-search"
            class="min-w-0 flex-1 bg-transparent px-3 text-sm text-ink outline-none placeholder:text-ink-soft"
            type="search"
            name="q"
            placeholder="Search calculators…"
            autocomplete="off"
          />
          <button
            class="grid size-10 place-items-center rounded-md bg-brand text-on-brand transition-colors hover:bg-brand-strong"
            type="submit"
            aria-label="Search all calculators"
          >
            <Search size={17} aria-hidden="true" />
          </button>
        </form>
        <div
          class="mt-2.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.68rem] text-ink-soft"
        >
          <span class="font-semibold">Popular searches:</span>
          {
            popularSearches.map((item) => (
              <a
                class="min-h-8 content-center text-brand hover:text-brand-strong"
                href={`/calculators/?q=${encodeURIComponent(item)}`}
              >
                {item}
              </a>
            ))
          }
        </div>
      </div>
      <AdSlot class="hidden min-h-48 md:grid lg:min-h-52" />
    </div>
  </section>

  <section id="popular-calculators" class="site-container py-7 sm:py-9">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-lg font-extrabold tracking-[-0.03em] text-ink">Popular Calculators</h2>
      <a
        class="inline-flex min-h-10 items-center gap-1 text-xs font-bold text-brand hover:text-brand-strong"
        href="/calculators/"
      >
        <span class="hidden sm:inline">View all calculators</span><span class="sm:hidden"
          >View all</span
        >
        <ArrowRight size={14} aria-hidden="true" />
      </a>
    </div>
    <div class="mt-3 grid gap-2 sm:grid-cols-2">
      {popularCalculators.map((calculator) => <CompactCalculatorItem calculator={calculator} />)}
    </div>
  </section>

  <section id="categories">
    <div class="site-container py-7 sm:py-9">
      <h2 class="text-lg font-extrabold tracking-[-0.03em] text-ink">Browse by Category</h2>
      <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-7">
        {
          calculatorCategories.map((category) => (
            <a
              href={`/calculators/#${category.id}`}
              class="flex min-h-20 flex-col items-center justify-center gap-1.5 rounded-control border border-line bg-panel px-2 text-center text-brand transition-[border-color,background-color] hover:border-brand/45 hover:bg-brand-soft"
            >
              <CategoryIcon name={category.icon} />
              <span class="text-[0.68rem] font-bold text-ink">{category.name}</span>
            </a>
          ))
        }
      </div>
      <div class="mt-3 text-center">
        <a
          class="inline-flex min-h-9 items-center gap-1 text-xs font-bold text-brand hover:text-brand-strong"
          href="/calculators/"
        >
          Browse all calculators <ArrowRight size={14} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="site-container py-5 sm:py-7">
    <div class="rounded-card border border-line bg-panel-muted p-4 sm:p-5">
      <h2 class="sr-only">Why use DailyUseCalc</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          trustPoints.map((point) => {
            const Icon = point.icon;
            return (
              <div class="flex min-w-0 items-center gap-2.5">
                <Icon className="shrink-0 text-brand" size={18} aria-hidden="true" />
                <div class="min-w-0">
                  <h3 class="text-xs font-bold text-ink">{point.title}</h3>
                  <p class="mt-0.5 text-[0.65rem] text-ink-soft">{point.detail}</p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <div class="site-container pt-1 pb-6 md:hidden"><AdSlot class="min-h-24" /></div>
</BaseLayout>
