---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy | DailyUseCalc"
  description="How DailyUseCalc handles information while you use its free browser-based calculators."
  canonicalPath="/privacy/"
>
  <article class="site-container max-w-3xl py-14 sm:py-20">
    <p class="text-sm font-bold text-brand">DailyUseCalc</p>
    <h1 class="mt-2 text-balance text-4xl font-extrabold tracking-[-0.055em] text-ink">
      Privacy policy
    </h1>
    <p class="mt-4 text-sm text-ink-soft">Last updated: August 9, 2026</p>
    <div class="mt-10 space-y-8 text-[0.98rem] leading-7 text-ink-soft">
      <section>
        <h2 class="text-xl font-extrabold tracking-[-0.03em] text-ink">Calculator information</h2><p
          class="mt-3"
        >
          DailyUseCalc performs calculator estimates in your browser. The measurements and optional
          pricing values you enter are not sent to a DailyUseCalc server by this version of the
          site.
        </p>
      </section>
      <section>
        <h2 class="text-xl font-extrabold tracking-[-0.03em] text-ink">Theme preference</h2><p
          class="mt-3"
        >
          If you select a display theme, the preference is stored locally in your browser so the
          site can remember it on later visits.
        </p>
      </section>
      <section>
        <h2 class="text-xl font-extrabold tracking-[-0.03em] text-ink">External services</h2><p
          class="mt-3"
        >
          This version of DailyUseCalc does not include advertising, accounts, payment processing,
          or third-party analytics. If those services are added later, this policy will be updated
          before they are enabled.
        </p>
      </section>
      <section>
        <h2 class="text-xl font-extrabold tracking-[-0.03em] text-ink">Contact</h2><p class="mt-3">
          For privacy questions, email <a
            class="font-semibold text-brand underline underline-offset-2"
            href="mailto:hello@dailyusecalc.com">hello@dailyusecalc.com</a
          >.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
