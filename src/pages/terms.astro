---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Use | DailyUseCalc"
  description="Terms for using the free browser-based tools available from DailyUseCalc."
  canonicalPath="/terms/"
>
  <article class="site-container max-w-3xl py-14 sm:py-20">
    <p class="text-sm font-bold text-brand">DailyUseCalc</p>
    <h1 class="mt-2 text-balance text-4xl font-extrabold tracking-[-0.055em] text-ink">
      Terms of use
    </h1>
    <p class="mt-4 text-sm text-ink-soft">Last updated: August 9, 2026</p>
    <div class="mt-10 space-y-8 text-[0.98rem] leading-7 text-ink-soft">
      <section>
        <h2 class="text-xl font-extrabold tracking-[-0.03em] text-ink">Use of estimates</h2><p
          class="mt-3"
        >
          DailyUseCalc provides general planning estimates. Material density, compaction, ground
          conditions, supplier ordering rules, and local requirements can affect a real project.
          Confirm critical quantities and specifications with a qualified professional or supplier
          before ordering.
        </p>
      </section>
      <section>
        <h2 class="text-xl font-extrabold tracking-[-0.03em] text-ink">No professional advice</h2><p
          class="mt-3"
        >
          The calculators and guides are informational tools, not engineering, construction, legal,
          financial, or other professional advice.
        </p>
      </section>
      <section>
        <h2 class="text-xl font-extrabold tracking-[-0.03em] text-ink">Acceptable use</h2><p
          class="mt-3"
        >
          Use the site lawfully and do not interfere with its normal operation, attempt to access
          unavailable areas, or represent the estimates as site-specific specifications from
          DailyUseCalc.
        </p>
      </section>
      <section>
        <h2 class="text-xl font-extrabold tracking-[-0.03em] text-ink">Contact</h2><p class="mt-3">
          Questions about these terms can be sent to <a
            class="font-semibold text-brand underline underline-offset-2"
            href="mailto:hello@dailyusecalc.com">hello@dailyusecalc.com</a
          >.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
