---
import { ArrowRight, ChevronRight, CircleHelp } from 'lucide-react';
import AdSlot from '../../components/common/AdSlot.astro';
import SandCalculator from '../../features/calculators/sand/SandCalculator';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculatorCategories } from '../../data/calculators';
import {
  breadcrumbSchema,
  faqPageSchema,
  organizationSchema,
  webApplicationSchema,
} from '../../lib/seo/schema';
const title = 'Sand Calculator - Cubic Yards, Tons, Bags & Cost | DailyUseCalc';
const description =
  'Calculate sand in cubic yards, cubic feet, cubic meters, tons, kilograms, and bags. Estimate paver, sandbox, landscaping, bulk orders, and optional material cost.';
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Construction', path: '/calculators/#construction' },
  { name: 'Sand Calculator', path: '/sand/' },
];
const faqs = [
  {
    question: 'How much sand do I need?',
    answer:
      'Measure the area, enter depth and quantity, then select allowance and any extra for compaction. The calculator converts required volume into cubic yards, cubic feet, cubic meters, liters, weight, bags, and bulk quantities.',
  },
  {
    question: 'How do I calculate cubic yards of sand?',
    answer:
      'Multiply total area by depth in consistent units, then divide cubic feet by 27. Allowance and compaction extras are each calculated from base volume and added without compounding.',
  },
  {
    question: 'How many tons are in a cubic yard of sand?',
    answer:
      'Weight varies with moisture, grading, and compaction. Using the calculator planning density of 2,700 pounds per cubic yard, one cubic yard is about 1.35 US short tons; use supplier density when available.',
  },
  {
    question: 'How many bags of sand do I need?',
    answer:
      'Choose whether the bag is sold by weight or volume and enter its labeled size. The calculator divides the required weight or volume by that size and rounds up to a whole bag.',
  },
  {
    question: 'How much area does one cubic yard of sand cover?',
    answer:
      'Coverage depends on depth. One cubic yard covers about 324 square feet at 1 inch, 162 square feet at 2 inches, 108 square feet at 3 inches, or 81 square feet at 4 inches.',
  },
  {
    question: 'Does sand weight vary?',
    answer:
      'Yes. Moisture, grading, compaction, and supplier material can materially change sand density and loaded weight.',
  },
  {
    question: 'How much sand do I need for pavers?',
    answer:
      'Enter the bedding area and specified compacted depth, then select any explicit allowance or compaction extra. Bedding sand and polymeric joint sand require different calculations; this tool estimates bedding or fill sand, not joint-sand coverage.',
  },
  {
    question: 'Should I buy bags or bulk sand?',
    answer:
      'Compare quantities, material prices, delivery, supplier minimums, access, and handling. The calculator presents material costs neutrally and does not assume delivery or fees.',
  },
  {
    question: 'Should I add extra for compaction?',
    answer:
      'Only add a compaction percentage when it is appropriate for the material and installation method. The calculator never selects it automatically, and it adds the percentage to base volume without compounding allowance.',
  },
  {
    question: 'Can I use supplier density?',
    answer:
      'Yes. Enter supplier density in the available unit and it overrides the transparent planning density for weight only. It never changes area or volume.',
  },
];
const guides = [
  [
    'Project, shapes, and known area',
    'Project type supplies guidance only. Measure rectangles, squares, circles, triangles, trapezoids, or rings, or enter a Known Area. For irregular ground, split it into simple shapes and calculate each separately.',
  ],
  [
    'Quantity, depth, and units',
    'Quantity multiplies the area of identical spaces before depth is applied. Enter the actual planned depth. Switching Imperial and Metric preserves the physical measurements.',
  ],
  [
    'Sand type, allowance, and compaction',
    'Sand type and project provide guidance only. Allowance and compaction are explicit percentages of base volume, added independently without hidden or compounded multipliers.',
  ],
  [
    'Bagged and bulk purchasing',
    'Bags may be entered by weight or volume and always round up to whole bags. Bulk may be ordered by volume or weight and stays exact unless you provide an increment.',
  ],
  [
    'Supplier density and weight',
    'The calculator uses a transparent 2,700 lb/cu yd planning density. Supplier density overrides it for weight only. Moisture, grading, and compaction affect actual loaded weight, so confirm supplier figures and payload limits.',
  ],
  [
    'Pricing and comparison',
    'Bag and bulk prices are optional. Comparisons cover material cost only; delivery, taxes, minimum orders, and supplier fees may not be included.',
  ],
  [
    'Coverage reference',
    'Coverage is unit volume divided by physical depth. It excludes allowance and compaction because those extras do not change the physical coverage relationship.',
  ],
  [
    'Worked example',
    'Imperial: 20 ft x 10 ft at 3 in is 50 cu ft or 1.85 cu yd before extras, about 2.50 US tons at the planning density. Metric: 5 m x 4 m at 50 mm is 1 cu m and covers 20 sq m per cubic meter.',
  ],
  [
    'Limitations',
    'This is a planning estimate. Moisture, grading, compaction, installation, supplier quantities, and measurement accuracy can change the final order.',
  ],
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/sand/"
  structuredData={[
    organizationSchema(),
    breadcrumbSchema(breadcrumbs),
    webApplicationSchema({ name: 'Sand Calculator', description, path: '/sand/' }),
    faqPageSchema(faqs),
  ]}
>
  <div class="site-container py-3 sm:py-4">
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-xs text-ink-soft">
      {
        breadcrumbs.map((item, index) => (
          <>
            <a class="rounded hover:text-brand" href={item.path}>
              {item.name}
            </a>
            {index < breadcrumbs.length - 1 && <ChevronRight size={13} aria-hidden="true" />}
          </>
        ))
      }
    </nav>
    <div class="mt-3 max-w-2xl">
      <h1 class="text-balance text-3xl font-extrabold tracking-[-.05em] text-ink sm:text-4xl">
        Sand Calculator
      </h1><p class="mt-1.5 text-sm leading-5 text-ink-soft">
        Calculate how much sand you need in cubic yards, cubic feet, cubic meters, tons, kilograms,
        bags, and bulk quantities for pavers, sandboxes, landscaping, leveling, pool bases, and
        more.
      </p><a
        href="#user-guide"
        data-sand-guide
        class="mt-2 inline-flex rounded text-sm font-semibold text-brand hover:underline"
        >User Guide</a
      >
    </div>
    <div
      class="mt-3 grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_13rem] xl:grid-cols-[minmax(0,1fr)_18rem]"
    >
      <div><SandCalculator client:load /><AdSlot class="mt-5 min-h-24 lg:hidden" /></div><aside
        class="hidden space-y-3 lg:-mt-[5.75rem] lg:block"
        aria-label="Sand calculator resources"
      >
        <AdSlot class="min-h-44 xl:min-h-60" /><section
          class="rounded-card border border-line bg-panel p-5 shadow-card"
        >
          <h2 class="text-base font-extrabold">Related calculators</h2><ul
            class="mt-4 space-y-3 text-sm font-semibold text-brand"
          >
            <li><a href="/gravel/">Gravel Calculator</a></li><li>
              <a href="/concrete/">Concrete Calculator</a>
            </li><li><a href="/mulch/">Mulch Calculator</a></li><li>
              <a href="/topsoil/">Topsoil Calculator</a>
            </li>
          </ul>
        </section>
        <section class="rounded-card border border-line bg-panel p-4 shadow-card">
          <h2 class="text-sm font-extrabold tracking-[-0.025em] text-ink">Browse by category</h2>
          <nav class="mt-2 grid" aria-label="Calculator categories">
            {
              calculatorCategories.map((category) => (
                <a
                  class="min-h-9 content-center text-xs font-semibold text-brand hover:text-brand-strong"
                  href={`/calculators/#${category.id}`}
                >
                  {category.name}
                </a>
              ))
            }
          </nav>
        </section>
      </aside>
    </div>
    <section
      id="user-guide"
      class="mt-16 scroll-mt-24 border-t border-line pt-12 sm:mt-20 sm:pt-16"
    >
      <div class="max-w-3xl">
        <p class="text-sm font-bold text-brand">Sand planning guide</p><h2
          class="mt-1 text-3xl font-extrabold tracking-[-.045em]"
        >
          Sand Calculator User Guide
        </h2>
      </div><div class="mt-8 grid gap-x-10 gap-y-8 text-sm leading-6 text-ink-soft md:grid-cols-2">
        {
          guides.map(([heading, content]) => (
            <section class="border-l-2 border-brand/25 pl-4">
              <>
                <h3 class="font-extrabold text-ink">{heading}</h3>
                <p class="mt-2">{content}</p>
              </>
            </section>
          ))
        }
      </div>
    </section>
    <section class="mt-16 border-t border-line pt-12 sm:mt-20 sm:pt-16">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-extrabold tracking-[-.045em]">Sand calculator questions</h2>
      </div><div class="mt-7 grid gap-3 lg:grid-cols-2">
        {
          faqs.map((faq) => (
            <details class="rounded-card border border-line bg-panel p-5 shadow-card">
              <>
                <summary class="flex cursor-pointer items-start gap-3 text-sm font-extrabold marker:content-none">
                  <CircleHelp className="mt-0.5 shrink-0 text-brand" size={18} aria-hidden="true" />
                  {faq.question}
                </summary>
                <p class="ml-[1.9rem] mt-3 text-sm leading-6 text-ink-soft">{faq.answer}</p>
              </>
            </details>
          ))
        }
      </div>
    </section>
    <section class="mt-16 rounded-2xl border border-brand/25 bg-brand-soft p-6 sm:mt-20 sm:p-8">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
        <h2 class="text-2xl font-extrabold">Find the next calculator for your project.</h2><a
          href="/calculators/"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-control bg-brand px-5 text-sm font-bold text-white"
          >Browse calculators <ArrowRight size={17} aria-hidden="true" /></a
        >
      </div>
    </section>
  </div>
  <script>
    import { trackCalculatorEvent } from '../../lib/analytics/calculatorAnalytics';
    document.querySelector('[data-sand-guide]')?.addEventListener('click', () =>
      trackCalculatorEvent('calculator_guide', {
        calculator_id: 'sand',
        calculator_name: 'Sand Calculator',
      }),
    );
  </script>
</BaseLayout>
