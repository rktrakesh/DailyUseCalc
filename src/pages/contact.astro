---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact DailyUseCalc | Feedback & Support"
  description="Contact DailyUseCalc for calculator feedback, technical issues, corrections, accessibility concerns, or general questions."
  canonicalPath="/contact/"
>
  <article class="site-container max-w-3xl py-14 sm:py-20">
    <p class="text-sm font-bold text-brand">DailyUseCalc</p>
    <h1 class="mt-2 text-balance text-4xl font-extrabold tracking-[-0.055em] text-ink">
      Contact DailyUseCalc
    </h1>
    <p class="mt-5 text-lg leading-8 text-ink-soft">
      Get in touch with feedback, questions, or a problem using a DailyUseCalc tool.
    </p>

    <div class="mt-10 space-y-8 text-[0.98rem] leading-7 text-ink-soft">
      <section>
        <h2 class="text-xl font-extrabold tracking-[-0.03em] text-ink">How we can help</h2>
        <p class="mt-3">
          You can contact DailyUseCalc about calculator feedback, incorrect or unexpected results,
          technical or accessibility problems, privacy questions, and general questions.
        </p>
      </section>

      <section class="rounded-card border border-line bg-panel p-6 shadow-card">
        <h2 class="text-xl font-extrabold tracking-[-0.03em] text-ink">Email</h2>
        <p class="mt-3">
          <a
            class="font-semibold text-brand underline underline-offset-2"
            href="mailto:rktripathy.business@gmail.com">rktripathy.business@gmail.com</a
          >
        </p>
        <p class="mt-4 text-sm leading-6 text-ink-soft">
          When reporting a calculator issue, include the calculator name, the values entered, and
          the result received so the issue can be understood and checked.
        </p>
      </section>
    </div>

    <a
      class="mt-10 inline-flex min-h-11 items-center justify-center rounded-control border border-line bg-panel px-5 text-sm font-bold text-ink transition-colors hover:bg-panel-muted"
      href="/">Return to DailyUseCalc</a
    >
  </article>
</BaseLayout>
