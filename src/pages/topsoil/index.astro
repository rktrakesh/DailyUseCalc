---
import { ArrowRight, ChevronRight, CircleHelp } from 'lucide-react';
import AdSlot from '../../components/common/AdSlot.astro';
import TopsoilCalculator from '../../features/calculators/topsoil/TopsoilCalculator';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  breadcrumbSchema,
  faqPageSchema,
  organizationSchema,
  webApplicationSchema,
} from '../../lib/seo/schema';
const title = 'Topsoil Calculator - Cubic Yards, Bags & Cost | DailyUseCalc';
const description =
  'Calculate topsoil in cubic yards, cubic feet, cubic meters, liters, bags, and bulk orders. Estimate optional supplier weight and material cost.';
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Landscaping', path: '/calculators/#garden' },
  { name: 'Topsoil Calculator', path: '/topsoil/' },
];
const faqs = [
  {
    question: 'How much topsoil do I need?',
    answer:
      'Measure the area, enter the intended depth and quantity of identical areas, then add any allowance. The calculator converts the resulting volume into cubic yards, cubic feet, cubic meters, liters, bags, and bulk quantities.',
  },
  {
    question: 'How do I calculate cubic yards of topsoil?',
    answer:
      'Multiply total area by depth in consistent units to get volume, then divide cubic feet by 27. This calculator performs the unit conversions and applies only the allowance you select.',
  },
  {
    question: 'How deep should topsoil be?',
    answer:
      'Depth depends on the project, existing soil, finished grade, drainage, and planting needs. Enter the depth appropriate for your site; the calculator does not silently choose one.',
  },
  {
    question: 'How many bags of topsoil do I need?',
    answer:
      'Enter the bag volume printed on the product. The required volume is divided by bag volume and rounded up because partial retail bags cannot be purchased.',
  },
  {
    question: 'How much area does one cubic yard of topsoil cover?',
    answer:
      'Coverage depends on depth. One cubic yard covers about 324 square feet at 1 inch, 162 square feet at 2 inches, 108 square feet at 3 inches, or 81 square feet at 4 inches.',
  },
  {
    question: 'Does topsoil weight vary?',
    answer:
      'Yes. Moisture, composition, organic matter, and compaction can materially change topsoil weight.',
  },
  {
    question: "Why doesn't the calculator assume one topsoil weight?",
    answer:
      'There is no reliable universal density. Weight is shown only when you enter a density or weight per volume supplied for the material.',
  },
  {
    question: 'Should I buy bags or bulk topsoil?',
    answer:
      'Compare quantities, material prices, delivery, supplier minimums, access, and handling. The calculator presents material costs neutrally and does not assume delivery or fees.',
  },
  {
    question: 'How much extra topsoil should I order?',
    answer:
      'Allowance may help cover measurement uncertainty, uneven grading, handling loss, or settling. The appropriate amount depends on the site and supplier, so choose it explicitly.',
  },
  {
    question: 'Can I use the calculator for raised beds?',
    answer:
      'Yes. Enter the bed dimensions, quantity of identical beds, and actual fill depth. Split irregular projects into simple shapes and calculate them separately.',
  },
];
const guides = [
  [
    'Project, shapes, and known area',
    'Project type supplies guidance only. Measure rectangles, squares, circles, triangles, trapezoids, or rings, or enter a Known Area. For irregular ground, split it into simple shapes and calculate each separately.',
  ],
  [
    'Quantity, depth, and units',
    'Quantity multiplies the area of identical spaces before depth is applied. Enter the actual planned depth. Switching Imperial and Metric preserves the physical measurements.',
  ],
  [
    'Soil type and allowance',
    'Soil type provides context only and never changes volume or weight. Extra allowance is transparent and may help with measurement uncertainty, uneven grading, handling loss, or settling.',
  ],
  [
    'Bagged and bulk purchasing',
    'Bag counts use bag volume and round upward. Bulk quantity uses the exact requirement unless you provide a supplier order increment; then it rounds upward to that increment. Leftover is purchased volume minus required volume.',
  ],
  [
    'Supplier density and weight',
    'Topsoil weight varies with moisture, composition, organic matter, and compaction, so DailyUseCalc assumes no universal density. No density means no weight result. With supplier density, required weight equals required volume x density, and ordered weight uses the rounded bulk order. Confirm loaded weight and vehicle or trailer payload before hauling.',
  ],
  [
    'Pricing and comparison',
    'Bag and bulk prices are optional. Comparisons cover material cost only; delivery, taxes, minimum orders, and supplier fees may not be included.',
  ],
  [
    'Coverage reference',
    'Coverage per cubic yard equals 27 cubic feet divided by depth in feet. It uses physical depth and excludes allowance; it is a reference, not a reverse calculator.',
  ],
  [
    'Worked example',
    'A 20 ft x 10 ft bed is 200 sq ft. At 4 in deep it has about 66.67 cu ft, or 2.47 cu yd, before allowance. A 5% allowance brings it to 2.59 cu yd; a 0.25-cu-yd increment rounds to 2.75 cu yd. One cu yd covers about 81 sq ft at 4 in. At a supplier-provided 2,200 lb/cu yd density, required weight is about 5,704 lb and ordered weight is 6,050 lb.',
  ],
  [
    'Limitations',
    'This is a planning estimate. Grade, compaction, moisture, soil composition, installation, supplier quantities, and measurement accuracy can change the final order.',
  ],
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/topsoil/"
  structuredData={[
    organizationSchema(),
    breadcrumbSchema(breadcrumbs),
    webApplicationSchema({ name: 'Topsoil Calculator', description, path: '/topsoil/' }),
    faqPageSchema(faqs),
  ]}
>
  <div class="site-container py-3 sm:py-4">
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-xs text-ink-soft">
      {
        breadcrumbs.map((item, index) => (
          <>
            <a class="rounded hover:text-brand" href={item.path}>
              {item.name}
            </a>
            {index < breadcrumbs.length - 1 && <ChevronRight size={13} aria-hidden="true" />}
          </>
        ))
      }
    </nav>
    <div class="mt-3 max-w-2xl">
      <h1 class="text-balance text-3xl font-extrabold tracking-[-.05em] text-ink sm:text-4xl">
        Topsoil Calculator
      </h1><p class="mt-1.5 text-sm leading-5 text-ink-soft">
        Calculate topsoil volume in cubic yards, cubic feet, cubic meters, liters, bags, and bulk
        quantities for gardens, lawns, raised beds, and landscaping.
      </p><a
        href="#user-guide"
        data-topsoil-guide
        class="mt-2 inline-flex rounded text-sm font-semibold text-brand hover:underline"
        >User Guide</a
      >
    </div>
    <div
      class="mt-3 grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_13rem] xl:grid-cols-[minmax(0,1fr)_18rem]"
    >
      <div><TopsoilCalculator client:load /><AdSlot class="mt-5 min-h-24 lg:hidden" /></div><aside
        class="hidden space-y-3 lg:-mt-[5.75rem] lg:block"
        aria-label="Topsoil calculator resources"
      >
        <AdSlot class="min-h-44 xl:min-h-60" /><section
          class="rounded-card border border-line bg-panel p-5 shadow-card"
        >
          <h2 class="text-base font-extrabold">Related calculators</h2><ul
            class="mt-4 space-y-3 text-sm font-semibold text-brand"
          >
            <li><a href="/mulch/">Mulch Calculator</a></li><li>
              <a href="/gravel/">Gravel Calculator</a>
            </li><li><a href="/concrete/">Concrete Calculator</a></li>
          </ul>
        </section><section class="rounded-card border border-line bg-panel p-4 shadow-card">
          <h2 class="text-sm font-extrabold">Browse by category</h2><a
            class="mt-2 block text-xs font-semibold text-brand"
            href="/calculators/#garden">Garden & Landscaping</a
          ><a class="mt-3 block text-xs font-semibold text-brand" href="/calculators/#construction"
            >Construction</a
          >
        </section>
      </aside>
    </div>
    <section id="user-guide" class="mt-16 scroll-mt-24 border-t border-line pt-12">
      <p class="text-sm font-bold text-brand">Topsoil planning guide</p><h2
        class="mt-1 text-3xl font-extrabold tracking-[-.045em]"
      >
        Topsoil Calculator User Guide
      </h2><div class="mt-6 grid gap-6 text-sm leading-6 text-ink-soft md:grid-cols-2">
        {
          guides.map(([heading, content]) => (
            <section>
              <>
                <h3 class="font-extrabold text-ink">{heading}</h3>
                <p class="mt-1">{content}</p>
              </>
            </section>
          ))
        }
      </div>
    </section>
    <section class="mt-16 border-t border-line pt-12">
      <h2 class="text-3xl font-extrabold tracking-[-.045em]">Topsoil calculator questions</h2><div
        class="mt-7 grid gap-3 lg:grid-cols-2"
      >
        {
          faqs.map((faq) => (
            <details class="rounded-card border border-line bg-panel p-5 shadow-card">
              <>
                <summary class="flex cursor-pointer items-start gap-3 text-sm font-extrabold marker:content-none">
                  <CircleHelp className="mt-0.5 shrink-0 text-brand" size={18} aria-hidden="true" />
                  {faq.question}
                </summary>
                <p class="ml-[1.9rem] mt-3 text-sm leading-6 text-ink-soft">{faq.answer}</p>
              </>
            </details>
          ))
        }
      </div>
    </section>
    <section class="mt-16 rounded-2xl border border-brand/25 bg-brand-soft p-6">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
        <h2 class="text-2xl font-extrabold">Find the next calculator for your project.</h2><a
          href="/calculators/"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-control bg-brand px-5 text-sm font-bold text-white"
          >Browse calculators <ArrowRight size={17} aria-hidden="true" /></a
        >
      </div>
    </section>
  </div>
</BaseLayout>
<script>
  import { trackCalculatorEvent } from '../../lib/analytics/calculatorAnalytics';
  document.querySelector('[data-topsoil-guide]')?.addEventListener('click', () =>
    trackCalculatorEvent('calculator_guide', {
      calculator_id: 'topsoil',
      calculator_name: 'Topsoil Calculator',
    }),
  );
</script>
