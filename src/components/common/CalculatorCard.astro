---
import { ArrowUpRight, Calculator } from 'lucide-react';
import type { CalculatorListing } from '../../data/calculators';

interface Props {
  calculator: CalculatorListing;
}

const { calculator } = Astro.props;
const isAvailable = calculator.status === 'available';
---

<article
  data-calculator-card
  data-searchable={[calculator.name, calculator.description, ...calculator.keywords]
    .join(' ')
    .toLowerCase()}
  class="group rounded-card border border-line bg-panel p-5 shadow-card transition-[border-color,transform,box-shadow] hover:border-brand/45 hover:shadow-float"
>
  <div class="flex items-start justify-between gap-4">
    <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-brand-soft text-brand">
      <Calculator size={20} aria-hidden="true" />
    </span>
    {
      !isAvailable && (
        <span class="rounded-full bg-panel-muted px-2.5 py-1 text-[0.65rem] font-bold uppercase tracking-[0.08em] text-ink-soft">
          Coming soon
        </span>
      )
    }
  </div>
  <h3 class="mt-5 text-base font-bold tracking-[-0.025em] text-ink">{calculator.name}</h3>
  <p class="mt-2 text-sm leading-5 text-ink-soft">{calculator.description}</p>
  {
    isAvailable ? (
      <a
        class="mt-5 inline-flex min-h-10 items-center gap-1.5 rounded-control text-sm font-bold text-brand hover:text-brand-strong"
        href={calculator.href}
      >
        Open calculator <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    ) : (
      <span class="mt-5 inline-flex min-h-10 items-center text-sm font-semibold text-ink-soft">
        In development
      </span>
    )
  }
</article>
