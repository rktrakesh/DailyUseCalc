---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a
  href="/"
  class="inline-flex items-center gap-2 rounded-md text-current no-underline"
  aria-label="DailyUseCalc home"
>
  <img
    src="/logo/dailyusecalc-logo.png"
    alt=""
    width="48"
    height="48"
    class="size-10 shrink-0 object-contain sm:size-11"
  />
  {
    !compact && (
      <span class="text-[0.95rem] font-bold tracking-[-0.04em]" translate="no">
        DailyUse<span class="text-brand">Calc</span>
      </span>
    )
  }
</a>
