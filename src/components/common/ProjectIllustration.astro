---
import { Calculator, Leaf, Plus } from 'lucide-react';
---

<div class="relative mx-auto hidden min-h-72 w-full max-w-sm items-center justify-center lg:flex" aria-hidden="true">
	<div class="absolute inset-x-10 bottom-8 h-16 rounded-[50%] bg-brand/10 blur-2xl"></div>
	<div class="absolute right-5 bottom-7 text-[#5e8f43]"><Leaf size={54} strokeWidth={1.3} /></div>
	<div class="absolute bottom-5 left-4 grid w-28 grid-cols-6 gap-1 opacity-70">
		{Array.from({ length: 24 }).map((_, index) => <span class:list={['aspect-square rounded-full bg-[#818487]', index % 4 === 0 && 'bg-[#64686b]']}></span>)}
	</div>
	<div class="relative z-10 w-44 -rotate-[-10deg] rounded-2xl border-4 border-[#16434b] bg-[#22616a] p-3 shadow-[0_20px_28px_rgb(8_32_37/0.25)]">
		<div class="rounded-lg bg-[#e7f0e8] px-3 py-2 text-right font-mono text-3xl tracking-[-0.12em] text-[#16313a] shadow-inner">123</div>
		<div class="mt-3 grid grid-cols-4 gap-1.5">
			{Array.from({ length: 12 }).map((_, index) => <span class:list={['grid aspect-square place-items-center rounded-md bg-[#1b5058] text-xs font-bold text-white shadow-sm', index === 11 && 'bg-[#0d3940']}>{index === 0 ? <Plus size={12} /> : index + 1}</span>)}
		</div>
	</div>
	<div class="absolute right-10 top-8 grid size-14 place-items-center rounded-2xl border border-brand/15 bg-brand-soft/50 text-brand"><Calculator size={25} /></div>
</div>
