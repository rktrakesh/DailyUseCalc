---
import '../styles/global.css';
import { absoluteUrl, SITE_NAME } from '../lib/seo/site';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | false;
  robots?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  robots = 'index, follow',
  structuredData,
} = Astro.props;
const metadataPath = typeof canonicalPath === 'string' ? canonicalPath : Astro.url.pathname;
const schemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const analyticsEnabled = import.meta.env.PROD && /^G-[A-Z0-9]+$/.test(gaMeasurementId || '');
const gaInitialization = `
  if (window.location.hostname === 'dailyusecalc.com' && !window.__dailyUseCalcGaLoaded) {
    window.__dailyUseCalcGaLoaded = true;

    var gaScript = document.createElement('script');
    gaScript.async = true;
    gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}';
    document.head.appendChild(gaScript);

    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function(){dataLayer.push(arguments);};
    window.gtag('js', new Date());
    window.gtag('config', ${JSON.stringify(gaMeasurementId)});
  }
`;
---

<!doctype html>
<html lang="en" data-theme="light" data-theme-preference="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#fbfcfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d171a" media="(prefers-color-scheme: dark)" />
    {canonicalPath && <link rel="canonical" href={absoluteUrl(canonicalPath)} />}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="DailyUseCalc" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteUrl(metadataPath)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('duc-theme');
        const theme = savedTheme === 'dark' ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themePreference = theme;
        document.documentElement.style.colorScheme = theme;
      } catch {}
    </script>
    {analyticsEnabled && <script is:inline set:html={gaInitialization} />}
    {
      schemas.map((schema) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body class="bg-surface text-ink antialiased">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
